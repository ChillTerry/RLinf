<?xml version="1.0"?>
<package format="3">
  <name>go2_vln_socket_gateway</name>
  <version>0.1.0</version>
  <description>RealSense/SDK2 camera, TCP action/image, and UDP heartbeat gateway for RLinf Go2 VLN.</description>
  <maintainer email="rlinf@example.com">RLinf Authors</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>go2_vln_executor</exec_depend>
  <exec_depend>go2_vln_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- pyrealsense2 is supplied by the robot's librealsense installation. -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>unitree_go</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
